# Local development settings (copy to .env — .env is git-ignored).
# Not used on Replit (Replit uses Secrets).

# Local PostgreSQL. Replace the password with the one you set when installing.
DATABASE_URL=postgres://postgres:YOUR_PG_PASSWORD@localhost:5432/synergy

# Password for the local /admin console (any value for local use).
ADMIN_PASSWORD=local-admin-pass

# Optional: Gemini features (news/talent auto-collection, brochure analysis).
# Leave empty to skip; those buttons will return an error locally.
# AI_INTEGRATIONS_GEMINI_BASE_URL=
# AI_INTEGRATIONS_GEMINI_API_KEY=

# Optional ports
# API_PORT=8080
# WEB_PORT=5173
