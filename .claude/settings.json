{
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm run typecheck*)",
      "Bash(pnpm run build*)",
      "Bash(pnpm test*)",
      "Bash(pnpm run dev:local*)",
      "Bash(pnpm run db:push:local*)",
      "Bash(pnpm --filter * run *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force*)",
      "Bash(git push origin main*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-session-start.sh\""
          }
        ]
      }
    ]
  }
}
